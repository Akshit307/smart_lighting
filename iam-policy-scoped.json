{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "iot:*",
        "sns:*",
        "sqs:*",
        "dynamodb:*",
        "timestream:*",
        "lambda:*",
        "logs:*",
        "cloudwatch:*",
        "servicequotas:*",
        "iam:PassRole",
        "iam:GetRole"
      ],
      "Resource": "*"
    }
  ]
}